<?xml version="1.0"?>
<package format="3">
  <name>lantern_location</name>
  <version>1.0.0</version>
  <description>Filters depth images using semantic segmentation and publishes 3D point clouds of detected lanterns</description>
  <maintainer email="daniel.platzner@tum.de">daniel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
